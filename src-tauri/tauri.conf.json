{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenDIY Desktop",
  "version": "0.6.0",
  "identifier": "io.agentgrid.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "OpenDIY Desktop", "dragDropEnabled": false, "width": 1400, "height": 900, "minWidth": 800, "minHeight": 540 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md", "../LICENSE": "LICENSE" },
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "shortDescription": "Local coding agent terminal workspace",
    "windows": { "nsis": { "installMode": "currentUser", "displayLanguageSelector": false } }
  }
}
